diff --git a/src/platform.c b/src/platform.c
index fab3057..e83efd5 100644
--- a/src/platform.c
+++ b/src/platform.c
@@ -140,0 +141,22 @@ void platform_stop(enum platform system) {
+static FILE* probe_stream;
+static int probe_setup(int format, int width, int height, int fps, void* context, int flags) {
+  const char* path = getenv("STREAMDESK_VIDEO_PROBE");
+  if (!path || format != VIDEO_FORMAT_H264) return -1;
+  probe_stream = fopen(path, "wb");
+  return probe_stream ? 0 : -1;
+}
+static int probe_submit(PDECODE_UNIT frame) {
+  if (getenv("STREAMDESK_BENCHMARK"))
+    fprintf(stderr, "PROFILE_SAMPLE %d %u %llu\n", frame->frameNumber, frame->frameHostProcessingLatency,
+            (unsigned long long)(frame->enqueueTimeUs - frame->receiveTimeUs));
+  for (PLENTRY nal = frame->bufferList; nal; nal = nal->next) {
+    if (fwrite(nal->data, 1, nal->length, probe_stream) != (size_t)nal->length) return DR_NEED_IDR;
+  }
+  fflush(probe_stream);
+  return DR_OK;
+}
+static void probe_cleanup(void) {
+  if (probe_stream) fclose(probe_stream);
+  probe_stream = NULL;
+}
+static DECODER_RENDERER_CALLBACKS probe_decoder = { .setup=probe_setup, .submitDecodeUnit=probe_submit, .cleanup=probe_cleanup, .capabilities=CAPABILITY_DIRECT_SUBMIT };
@@ -142,0 +165 @@ DECODER_RENDERER_CALLBACKS* platform_get_video(enum platform system) {
+  case FAKE: return &probe_decoder;
